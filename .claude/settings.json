{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(./mvnw *)",
      "Bash(npm *)",
      "Bash(npx ng *)",
      "Bash(docker compose *)",
      "Bash(curl *)",
      "Bash(node -e *)",
      "Bash(netstat *)",
      "Bash(taskkill *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/compile-backend.js"],
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run-unit-tests.js"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}